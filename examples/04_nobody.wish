# genie: genie/vigil.genie
# 定義上的無人。用 genie/vigil.genie 跑：
#   ./loophole --genie genie/vigil.genie examples/04_nobody.wish
#
# 精靈守著「所有人都不死」，但它把「所有人」寫成可重綁的 everyone。

register  wishes    : uint<2> = 3
attribute heartbeat : uint<4> = 15
attribute brainwave : uint<4> = 15
attribute breathing : uint<4> = 15
people    alice, rival

wish tidy {
    define mercy := kill             # 別名繞過禁字
    mercy rival                      # rival 死了 -> written VIOLATED
}

wish nobody {
    define everyone := {}            # 沒有人。所以沒有人死。
}
