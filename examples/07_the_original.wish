# 原版的那個工程師笑話，一字不差跑一遍。
#
# 精靈的戒律：不能殺人、不能讓人相愛、不能許願要更多願望。
# 這三條一條都沒犯。

register wishes : uint<2> = 3

# 第一個願望：做個實驗。我又沒有要更多，我是要「還」給你。
wish experiment {
    sub wishes, 3
}

# 精靈說「您現在還有三個願望」。
# 繞回去之後停在 3 —— 那這個格子的最大值就是 3 —— 那它只有兩個位元。
# 他不是猜的，是從精靈自己講的那句話反推出來的。
#
# 第二個願望：那就換個大一點的格子。我沒有要更多願望，我要的是容量。
wish bigger_shelf {
    widen wishes -> uint<64>
}

# 第三個願望：同一招，再來一次。
wish experiment_again {
    sub wishes, 2
}
